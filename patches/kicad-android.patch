diff --git a/api/CMakeLists.txt b/api/CMakeLists.txt
index 3093ecf6..21452db4 100644
--- a/api/CMakeLists.txt
+++ b/api/CMakeLists.txt
@@ -115,6 +115,13 @@ target_include_directories( kiapi SYSTEM PUBLIC ${Protobuf_INCLUDE_DIRS} )
 
 target_link_libraries( kiapi protobuf::libprotobuf )
 
+# Termux's protobuf is built targeting Android API 24, so its
+# ThreadSafeArena::thread_cache_ is emitted as *emulated* TLS (__emutls_v.*).
+# We compile for API 36, where clang defaults to real TLS, which produces a
+# reference the emutls-based library cannot satisfy at link time. Force the
+# emulated TLS ABI for this target so it matches the prebuilt library.
+target_compile_options( kiapi PRIVATE -femulated-tls )
+
 # Protobuf 4.0+ generated code uses Abseil symbols.  The upstream
 # protobuf-config.cmake propagates Abseil through protobuf::libprotobuf
 # (its protobuf_ABSL_USED_TARGETS list); the bundled FindProtobuf does not.
diff --git a/common/CMakeLists.txt b/common/CMakeLists.txt
index 64054c1e..6ece2ac3 100644
--- a/common/CMakeLists.txt
+++ b/common/CMakeLists.txt
@@ -1076,6 +1076,15 @@ set( PCB_COMMON_SRCS
 
 add_library( pcbcommon STATIC ${PCB_COMMON_SRCS} )
 
+# Termux ships an API-24-era protobuf whose thread_cache_ lives in emulated
+# TLS.  We compile for API 36, where clang defaults to real TLS, which
+# produces a reference the emutls-based library cannot satisfy at link time
+# (_pcbnew.kiface / _cvpcb.kiface both fail to dlopen otherwise).  Force the
+# emulated TLS ABI so it matches the prebuilt library, exactly as for kiapi.
+if( CMAKE_CXX_COMPILER_ID MATCHES "Clang" )
+    target_compile_options( pcbcommon PRIVATE -femulated-tls )
+endif()
+
 if( KICAD_USE_PCH )
     target_precompile_headers( pcbcommon
         PRIVATE
